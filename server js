const http=require("http"),fs=require("fs"),path=require("path");
const PORT=process.env.PORT||3000,ROOT=path.join(__dirname,"public");
const MIME={".html":"text/html; charset=utf-8",".svg":"image/svg+xml",".txt":"text/plain"};
http.createServer((req,res)=>{let u=(req.url||"/").split("?")[0];if(u==="/healthz"){res.writeHead(200);return res.end("ok")}if(u.endsWith("/"))u+="index.html";const f=path.normalize(path.join(ROOT,u));if(!f.startsWith(ROOT)){res.writeHead(403);return res.end("no")}fs.readFile(f,(e,d)=>{if(e)return fs.readFile(path.join(ROOT,"index.html"),(e2,h)=>{if(e2){res.writeHead(404);return res.end("404")}res.writeHead(200,{"Content-Type":MIME[".html"]});res.end(h)});res.writeHead(200,{"Content-Type":MIME[path.extname(f)]||"application/octet-stream"});res.end(d)})}).listen(PORT,()=>console.log("port "+PORT));
